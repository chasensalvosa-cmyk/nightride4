# NIGHTRIDE environment — copy to .env for local development.
#
# Local dev uses the SQLite file database:
DATABASE_URL=file:./db/custom.db

# ── Hosting (Vercel / Cloudflare / self-host) ────────────────────────────────
# Do NOT use the file: URL there — serverless has no filesystem. Set DATABASE_URL
# to your hosted Postgres pooled connection string instead, e.g. Supabase:
#   DATABASE_URL=postgresql://postgres.abcdefgh:PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# The build (scripts/build.mjs) auto-detects postgres:// and switches the
# Prisma schema accordingly. Full walkthrough: DEPLOYMENT.md
